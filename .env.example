# PostgreSQL used by Docker Compose
POSTGRES_DB=movies
POSTGRES_USER=movies
POSTGRES_PASSWORD=movies
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Telegram and TMDB integrations
TG_BOT_TOKEN=replace-with-telegram-bot-token
TMDB_API_TOKEN=replace-with-tmdb-api-token
TMDB_BASE_URL=https://api.themoviedb.org/3
TMDB_LANGUAGE=ru-RU

# Frontend build configuration
VITE_API_BASE_URL=/api

# Backups are disabled for local development by default
BACKUP_ENABLED=false
BACKUP_SCHEDULE_ENABLED=false
BACKUP_ADMIN_CHAT_IDS=
BACKUP_SCHEDULE=03:00
BACKUP_TIMEZONE=Asia/Novosibirsk
